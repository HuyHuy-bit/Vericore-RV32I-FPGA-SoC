diff --git a/rtl/core/branch_predictor.sv b/rtl/core/branch_predictor.sv
index a18805a..e46b668 100644
--- a/rtl/core/branch_predictor.sv
+++ b/rtl/core/branch_predictor.sv
@@ -95,9 +95,11 @@ module branch_predictor #(
         if (rst) begin
             for (int i = 0; i < NUM_ENTRIES; i++) begin
                 bht[i]       <= 2'b01;             // weakly not-taken: neutral-ish start
+                // Only the valid bit needs a defined reset: every hit is
+                // qualified by btb_valid, so tag and target are never read
+                // before they are written. Leaving them unreset keeps the
+                // arrays out of flops, where a bulk clear would force them.
                 btb_valid[i] <= 1'b0;
-                btb_tag[i]   <= '0;
-                btb_tgt[i]   <= XLEN'(0);
             end
             ghistory <= '0;
         end else if (update_en) begin
diff --git a/rtl/core/frontend.sv b/rtl/core/frontend.sv
index 4be9173..8930cb7 100644
--- a/rtl/core/frontend.sv
+++ b/rtl/core/frontend.sv
@@ -127,7 +127,12 @@ module frontend #(
     // if_id_reg would actually latch it - re-presentations of a frozen or
     // held fetch must not push/pop twice.
     logic fetch_accept;
-    assign fetch_accept = !pipe_stall && !load_use_stall;
+    // A flush cycle's IF instruction is already known wrong and if_id_reg
+    // discards it, so pushing or popping the RAS for it corrupts the stack
+    // with a fetch the pipeline has already resolved as dead. This is not
+    // the deliberate speculation the RAS accepts elsewhere.
+    assign fetch_accept = !pipe_stall && !load_use_stall
+                          && !ex_flush && !trap_redirect;
 
     logic ras_push, ras_pop, ras_pop_valid;
     logic [XLEN-1:0] ras_pop_addr;
