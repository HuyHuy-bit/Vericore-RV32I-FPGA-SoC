     arty_a7_35t_top dut (
         .clk100(clk100),
@@ -43,12 +45,17 @@ module arty_post_route_tb;
             if (value !== EXPECTED[index])
                 $fatal(1, "UART mismatch at byte %0d: got %02x expected %02x",
                     index, value, EXPECTED[index]);
+            uart_byte = value;
